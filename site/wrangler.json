{
  "name": "tvremote",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "tvremote.vwave.me", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/download", "/latest.json"]
  }
}
